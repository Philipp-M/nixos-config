+
+pub(crate) async fn handle_llm_command_start(
+    daemon_state: Arc<Mutex<DaemonState>>,
+    context: Arc<DaemonContext>,
+    name: String,
+) -> Response {
+    let state = daemon_state.lock().await.state_machine.state();
+    if state != State::Idle {
+        return Response::Ok { state };
+    }
+
+    let entry = context
+        .config
+        .llm_commands
+        .iter()
+        .find(|entry| entry.name == name)
+        .cloned();
+    match entry {
+        Some(entry) => llm_command_start(daemon_state, context, entry, true).await,
+        None => Response::Error {
+            message: format!("no llm_commands entry named '{name}' — check config.toml"),
+        },
+    }
+}
+
+pub(crate) async fn handle_llm_command_stop(
+    daemon_state: Arc<Mutex<DaemonState>>,
+    context: Arc<DaemonContext>,
+    name: String,
+) -> Response {
+    let (state, matches) = {
+        let state = daemon_state.lock().await;
+        (
+            state.state_machine.state(),
+            state
+                .llm_command
+                .as_ref()
+                .is_some_and(|command| command.name == name),
+        )
+    };
+    if state != State::Recording {
+        return Response::Ok { state };
+    }
+    if !matches {
+        return Response::Ok { state };
+    }
+    handle_llm_command(daemon_state, context, name).await
 }

